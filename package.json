{
  "name": "deepsignal-walrus-feedback-lab",
  "private": true,
  "version": "0.5.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && npm run lint",
    "build": "npm run typecheck && vite build && node scripts/write-legacy-entry-stubs.mjs",
    "preview": "vite preview",
    "version:set": "tsx scripts/set-version.ts",
    "version:build": "tsx scripts/set-version.ts --build",
    "code:index": "tsx scripts/index-code.ts",
    "code:search": "tsx scripts/search-code.ts"
  },
  "dependencies": {
    "@mysten/dapp-kit": "^1.0.4",
    "@mysten/seal": "^1.1.1",
    "@mysten/sui": "^2.16.0",
    "@mysten/walrus": "^1.1.6",
    "@tanstack/react-query": "^5.100.9",
    "@tiptap/extension-link": "^3.23.1",
    "@tiptap/extension-placeholder": "^3.23.1",
    "@tiptap/extension-underline": "^3.23.1",
    "@tiptap/react": "^3.23.1",
    "@tiptap/starter-kit": "^3.23.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.26.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.31.1",
    "vite": "^5.4.10",
    "vitest": "^4.1.6"
  }
}
