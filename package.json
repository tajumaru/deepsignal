{
  "name": "deepsignal-walrus-feedback-lab",
  "private": true,
  "version": "0.12.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:zklogin-salt": "node scripts/zklogin-salt-service.mjs",
    "dev:drive-index-relay": "node scripts/google-drive-submission-index-relay.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:zklogin": "vitest run src/lib/zkloginAddress.test.ts src/lib/zkloginOAuth.test.ts src/lib/zkloginSession.test.ts src/lib/respondentMeta.test.ts src/lib/exportResponses.test.ts src/pages/ZkLoginCallbackPage.test.tsx src/pages/PublicFormPage.test.tsx --exclude ci-run-verify/** --exclude .ci-run-verify/**",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && npm run lint",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "fixture:insights": "node -e \"console.log('Open the running app at /#/dev/insights-fixture to seed browser-local Insights fixtures.')\"",
    "version:set": "tsx scripts/set-version.ts",
    "version:build": "tsx scripts/set-version.ts --build",
    "verify:dist-assets": "node scripts/verify-dist-chunk-dependencies.mjs",
    "code:index": "tsx scripts/index-code.ts",
    "code:search": "tsx scripts/search-code.ts"
  },
  "dependencies": {
    "@mysten/dapp-kit": "^1.0.6",
    "@mysten/seal": "^1.1.3",
    "@mysten/sui": "^2.17.0",
    "@mysten/suins": "^1.1.4",
    "@mysten/walrus": "^1.1.7",
    "@tanstack/react-query": "^5.100.11",
    "@tiptap/extension-link": "^3.23.5",
    "@tiptap/extension-placeholder": "^3.23.5",
    "@tiptap/extension-underline": "^3.23.5",
    "@tiptap/react": "^3.23.5",
    "@tiptap/starter-kit": "^3.23.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.26.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^5.4.10",
    "vitest": "^3.2.4"
  }
}
